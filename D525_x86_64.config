# =======================================================
# OpenWrt x86_64 顶级软路由配置清单
# Intel D525 Bonnell 专属极限版 - 全功能完整版
# =======================================================


#[模块 1]: 基础架构与编译选项
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -march=bonnell -mtune=bonnell -fomit-frame-pointer"

CONFIG_PACKAGE_iucode-tool=y

CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

CONFIG_DEVEL=y
CONFIG_CCACHE=y

CONFIG_DEBUG=n
CONFIG_DEBUG_INFO=n
CONFIG_COLLECT_KERNEL_DEBUG=n
CONFIG_STRIP_KERNEL_EXPORTS=y
CONFIG_SDK=n
CONFIG_IB=n
CONFIG_KO_SYMBOLS=n
CONFIG_BUILD_LOG=y


# =======================================================
# [模块 2]: 防火墙核心与兼容层
# fw4 + nftables + iptables-nft
# =======================================================

CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y

CONFIG_PACKAGE_kmod-nf-tproxy=y

CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-fib=y

CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-socket=y
CONFIG_PACKAGE_iptables-mod-ipopt=y

CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-ipt-extra=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-nat6=y

CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_kmod-ipt-ipset=y


# =======================================================
# [模块 3]: DNS 解析器支持
# =======================================================

CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=y

CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_auth=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_noid=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y


# =======================================================
# [模块 4]: 核心应用、代理模块与 VPN 共存环境
# =======================================================

CONFIG_XRAY_CORE_COMPRESS_UPX=n
CONFIG_SING_BOX_COMPRESS_UPX=n

CONFIG_PACKAGE_xray-core_compress_upx=n
CONFIG_PACKAGE_sing-box_compress_upx=n

CONFIG_PACKAGE_ipv6helper=y

CONFIG_PACKAGE_luci-app-unblockneteasemusic=y


# =======================================================
# PassWall 完整架构 (恢复全部功能组件)
# =======================================================

CONFIG_PACKAGE_luci-app-passwall=y

CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Iptables_Transparent_Proxy=y

CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y

CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=y

CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Client=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=y

CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Trojan_Plus=y

CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=y

CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy=y

CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Tuic_Client=y

CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin=y

CONFIG_PACKAGE_tcping=y


# =======================================================
# PassWall 核心区域结束
# =======================================================


# -------------------------------------------------------
# 广告拦截
# -------------------------------------------------------

CONFIG_PACKAGE_luci-app-adblock-fast=y
CONFIG_PACKAGE_adblock-fast=y


# =======================================================
# VPN 共存协议栈 (IPSec / WireGuard) 满血完整版
# =======================================================

CONFIG_PACKAGE_luci-app-ipsec-vpnd=y

# ⬇️ 完整版 StrongSwan 核心引擎与认证通讯组件 ⬇️
CONFIG_PACKAGE_strongswan=y
CONFIG_PACKAGE_strongswan-mod-xauth-generic=y
CONFIG_PACKAGE_strongswan-mod-kernel-libipsec=y
CONFIG_PACKAGE_strongswan-mod-stroke=y
CONFIG_PACKAGE_strongswan-mod-updown=y
CONFIG_PACKAGE_xl2tpd=y

# ⬇️ WireGuard 完整四件套 ⬇️
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_luci-proto-wireguard=y
# ⬆️ 必须包含 luci-proto-wireguard，否则接口协议下拉框将丢失 ⬆️

# WireGuard 依赖的内核加密模块（chacha20poly1305 必须同时启用 poly1305）
CONFIG_CRYPTO_LIB_POLY1305=m
CONFIG_CRYPTO_LIB_CHACHA20POLY1305=m

CONFIG_PACKAGE_luci-app-ttyd=y

CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y

CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-compat=y

CONFIG_PACKAGE_luci-app-usb-printer=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-filetransfer=y

CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-uhttpd=y

CONFIG_LUCI_THEME="argon"


# =======================================================
# [模块 5]: 硬件加速与老旧硬件兼容优化
# =======================================================

CONFIG_PACKAGE_util-linux=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_fstrim=y

CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y

CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-xfs=y
CONFIG_PACKAGE_kmod-fs-vfat=y

CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_ntfs-3g=y

CONFIG_PACKAGE_kmod-fs-f2fs=y

CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-utf8=y

CONFIG_PACKAGE_kmod-ata-ahci=y
CONFIG_PACKAGE_kmod-ata-piix=y

CONFIG_PACKAGE_libblkid=y
CONFIG_PACKAGE_libuuid=y
CONFIG_PACKAGE_uci=y


# =======================================================
# [模块 6]: 监控与统计组件
# =======================================================

CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_lm-sensors=y
CONFIG_PACKAGE_luci-app-statistics=y


# =======================================================
# [模块 7]: NAS 文件共享服务 (恢复纯血 Samba4 全功能)
# =======================================================

CONFIG_PACKAGE_luci-app-ksmbd=n
CONFIG_PACKAGE_ksmbd-server=n
CONFIG_PACKAGE_kmod-fs-ksmbd=n

CONFIG_PACKAGE_luci-app-samba=n
CONFIG_PACKAGE_samba36-server=n
CONFIG_PACKAGE_autosamba=n

CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-admin=y
CONFIG_PACKAGE_samba4-libs=y
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_wsdd2=y
CONFIG_PACKAGE_samba4-server-vfs=y


# =======================================================
# [模块 8]: 网络核心与校验环境
# =======================================================

CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_curl=y

CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-stat=y

CONFIG_PACKAGE_jq=y

CONFIG_PACKAGE_gawk=y
CONFIG_PACKAGE_grep=y
CONFIG_PACKAGE_sed=y
CONFIG_PACKAGE_coreutils-sort=y


# =======================================================
# [模块 9]: 底层运维工具与驱动增强
# =======================================================

CONFIG_PACKAGE_irqbalance=y

CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_btrfs-progs=y

CONFIG_PACKAGE_smartmontools=y

CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-inet-diag=y

CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_mtr=y

CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_DEFAULT_tcp_bbr=y


# =======================================================
# [模块 10]: 根分区扩容
# =======================================================

CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=800


# =======================================================
# [模块 11]: IPv6 协议栈完整支持
# =======================================================

CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_kmod-ipv6=y


# =======================================================
# [模块 12]: BBR 依赖与 CPU 调频
# =======================================================

CONFIG_PACKAGE_tc=y
CONFIG_PACKAGE_cpufrequtils=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_kmod-cpufreq=y
